# Company-standard theme, template, and reusable disclosure sections.
#
# Consumers should generally use the `responsible_disclosure` macro from
# //company:defs.bzl rather than depending on these targets directly, but the
# targets are public so bespoke documents can compose them as needed.

load(
    "@rules_farakov_documentation//documentation:defs.bzl",
    "doc_section",
    "doc_template",
    "doc_theme",
)

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

# --- Standard corporate theme --------------------------------------------

# Dark, monochrome theme matching the Farakov website (farakov-lander).
#
# The palette is derived from the site's design tokens (oklch -> sRGB):
# near-black surfaces, near-white text, a single near-white "primary" accent
# and hairline borders. The look is intentionally clean and restrained rather
# than flashy. Typography mirrors the site: SF Pro with a system-sans fallback.
doc_theme(
    name = "company_theme",
    theme_name = "company",
    colors = {
        # --foreground / --background: near-white text on near-black.
        "text": "#fafafa",
        "background": "#0a0a0a",
        # --primary: near-white. Used for headings, rules and links. The theme
        # is monochrome, so accent == bright neutral rather than a hue.
        "primary": "#e5e5e5",
        # --muted-foreground: secondary text, captions, the cover meta line.
        "muted": "#a1a1a1",
        # --border at ~10% white over the background: a hairline divider.
        "border": "#262626",
        # --card: slightly raised surface for code, quotes, TOC and table heads.
        "code_bg": "#171717",
    },
    typography = {
        "heading_font": "'SF Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
        "body_font": "'SF Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
        "mono_font": "'SF Mono', ui-monospace, Menlo, Consolas, monospace",
    },
    max_width = "880px",
    logo = "assets/farakov-logo.svg",
    website = "https://farakov.com",
    show_cover = True,
    show_toc = True,
)

# --- Responsible-disclosure template -------------------------------------

doc_template(
    name = "disclosure_template",
    template_name = "responsible-disclosure",
    theme = ":company_theme",
    show_cover = True,
    show_toc = True,
)

# --- Reusable disclosure boilerplate sections ----------------------------

doc_section(
    name = "sec_policy",
    title = "Responsible Disclosure Policy",
    srcs = ["disclosure/policy.md"],
)

doc_section(
    name = "sec_scope",
    title = "Scope",
    srcs = ["disclosure/scope.md"],
)

doc_section(
    name = "sec_reporting",
    title = "Reporting Process",
    srcs = ["disclosure/reporting.md"],
)

doc_section(
    name = "sec_severity",
    title = "Severity Scale",
    srcs = ["disclosure/severity.md"],
)

doc_section(
    name = "sec_safe_harbor",
    title = "Safe Harbor",
    srcs = ["disclosure/safe_harbor.md"],
)
